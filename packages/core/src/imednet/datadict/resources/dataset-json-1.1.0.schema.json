{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cdisc.org/ns/dataset-json/v1.1/dataset.schema.json",
  "title": "CDISC Dataset-JSON v1.1.0 Schema",
  "description": "Official CDISC Dataset-JSON v1.1.0 tabular exchange schema for clinical and reference datasets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetJSONCreationDateTime",
    "datasetJSONVersion",
    "itemGroupOID",
    "records",
    "name",
    "label",
    "columns",
    "rows"
  ],
  "properties": {
    "datasetJSONCreationDateTime": {
      "type": "string",
      "minLength": 1
    },
    "datasetJSONVersion": {
      "type": "string",
      "pattern": "^1\\.1\\.0$"
    },
    "fileOID": {
      "type": "string",
      "minLength": 1
    },
    "dbLastModifiedDateTime": {
      "type": "string",
      "minLength": 1
    },
    "originator": {
      "type": "string"
    },
    "sourceSystem": {
      "$ref": "#/$defs/SourceSystem"
    },
    "studyOID": {
      "type": "string",
      "minLength": 1
    },
    "metaDataVersionOID": {
      "type": "string",
      "minLength": 1
    },
    "metaDataRef": {
      "type": "string"
    },
    "itemGroupOID": {
      "type": "string",
      "minLength": 1
    },
    "isReferenceData": {
      "type": "boolean"
    },
    "records": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Column"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      }
    }
  },
  "$defs": {
    "SourceSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DataType": {
      "type": "string",
      "enum": [
        "string",
        "integer",
        "float",
        "double",
        "decimal",
        "boolean",
        "date",
        "time",
        "datetime",
        "URI",
        "partialDate",
        "partialTime",
        "partialDatetime",
        "durationDatetime"
      ]
    },
    "TargetDataType": {
      "type": "string",
      "enum": ["integer", "decimal"]
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemOID", "name", "label", "dataType"],
      "properties": {
        "itemOID": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "dataType": {
          "$ref": "#/$defs/DataType"
        },
        "targetDataType": {
          "$ref": "#/$defs/TargetDataType"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "displayFormat": {
          "type": "string"
        },
        "keySequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
