# Authentication (Required unless IMEDNET_OIDC_TOKEN or IMEDNET_SIMULATION_MODE is set)
IMEDNET_API_KEY=your_api_key_here
IMEDNET_SECURITY_KEY=your_security_key_here

# OIDC Authentication & Verification (Optional; defaults: None)
# IMEDNET_OIDC_TOKEN=your_oidc_token_here
# IMEDNET_OIDC_PUBLIC_KEY=your_oidc_public_key_pem_or_secret
# IMEDNET_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# IMEDNET_OIDC_AUDIENCE=imednet-api
# IMEDNET_OIDC_ALGORITHMS=RS256,ES256
# IMEDNET_OIDC_ISSUER=https://idp.example.com/

# API Endpoint, Timeout, Simulation & Validation Modes (Optional)
# IMEDNET_BASE_URL=https://edc.prod.imednetapi.com  # Default: None (uses production URL)
# IMEDNET_TIMEOUT=30.0  # Default HTTP request timeout in seconds
# IMEDNET_SIMULATION_MODE=false  # Set true or 1 for offline SimulationTransport
# IMEDNET_STRICT_MODE=false  # Set true or 1 for strict SDK response validation
# IMEDNET_STRICT_CDASH=false  # Set true or 1 for CDASH variable naming heuristics

# CLI, TUI & Contract Schema Overrides (Optional)
# IMEDNET_NON_INTERACTIVE=0  # Set 1, true, or yes to disable curses grids, TUI, and prompts
# IMEDNET_CLI_OUTPUT_FORMAT=table  # Set json to default --format commands to JSON
# IMEDNET_HIGH_CONTRAST=0  # Set 1 to enable high-contrast CLI/TUI palettes
# IMEDNET_OPENAPI_PATH=  # Optional OpenAPI spec file path override (default: None)
# IMEDNET_POSTMAN_PATH=  # Optional Postman collection JSON path override (default: None)

# Workflow Stores & Checkpoints (Optional)
# IMEDNET_CONFIG_DB_PATH=~/.imednet/config_versions.sqlite3
# IMEDNET_ENCRYPTION_KEY=your_config_encryption_key_here  # Falls back to IMEDNET_SECURITY_KEY
# IMEDNET_WORKFLOW_LEDGER_PATH=~/.imednet/pipeline_ledger.json
# IMEDNET_TRIAGE_DB_PATH=~/.imednet/triage.sqlite3

# Testing & Development (Optional)
# IMEDNET_STUDY_KEY=your_study_key_for_tests
# IMEDNET_RUN_E2E=1  # Enable live end-to-end tests
# IMEDNET_JOB_STUDY_KEY=  # Study key for polling job in async example
# IMEDNET_BATCH_ID=  # For job polling tests
# IMEDNET_FORM_KEY=  # For record creation tests
# IMEDNET_ALLOW_MUTATION=1  # Allow write operations in live tests
