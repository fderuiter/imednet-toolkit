graph TD
    accTitle: Epoch-Fenced Delta Sync and SyncWorker Health Lifecycle
    accDescr: Flowchart showing SyncWorker running lock-free remote delta, projection, and missing-record fetches before a single atomic FileLock SQLite commit for upserts, epoch-fenced orphan reconciliation, and watermark updates across RUNNING, DEGRADED, FAILED, and STOPPED states
    A[run_forever] --> B{stop_event set?}
    B -- No --> C[_fetch_delta_records]
    C --> D[_fetch_active_records_projection]
    D --> E[_fetch_missing_records]
    E --> F["FileLock: atomic _upsert_records_unlocked + reconcile_cache + watermark"]
    F --> H{cycle succeeded?}
    H -- Yes --> I[state = RUNNING]
    I --> M[wait interval_seconds]
    H -- No --> J{failure limit reached?}
    J -- No --> K[state = DEGRADED]
    K --> M
    M --> B
    J -- Yes --> L[state = FAILED]
    B -- Yes --> N[state = STOPPED]
